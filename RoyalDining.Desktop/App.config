<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<!-- ⚠️ SESUAIKAN Server= dengan instalasi SQL Server Anda -->
		<!-- Default instance: localhost atau . -->
		<!-- SQL Express: .\SQLEXPRESS -->
		<add name="RoyalDiningDB"
			 connectionString="Server=(localdb)\MSSQLLocalDB;Database=RoyalDiningDB;Trusted_Connection=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>