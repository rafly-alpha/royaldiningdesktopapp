<Application x:Class="RoyalDining.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:RoyalDining.Desktop.Converters"
             StartupUri="Views/Auth/LoginView.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                              PrimaryColor="Amber"
                                              SecondaryColor="Yellow" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />

                <!-- Shared Styles -->
                <ResourceDictionary Source="Themes/SharedStyles.xaml"/>

                <!-- Default Theme: Light -->
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>
                
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <converters:ImagePathConverter x:Key="ImagePathConverter"/>
            <converters:InitialsConverter x:Key="InitialsConverter"/>
            
            

        </ResourceDictionary>
    </Application.Resources>
</Application>