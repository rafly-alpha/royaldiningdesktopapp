<UserControl x:Class="RoyalDining.Desktop.Views.Customer.CustomerOrderDetailDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="500"
             Background="{DynamicResource SurfaceBrush}" 
             Foreground="{DynamicResource TextPrimaryBrush}">
    <StackPanel Margin="24">
        <TextBlock x:Name="TxtTitle" Text="Detail Pesanan" Style="{StaticResource H2}" Margin="0,0,0,20"/>

        <!-- Info Status & Tanggal -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Tanggal" Style="{StaticResource SecondaryText}"/>
                <TextBlock x:Name="TxtDate" Text="Tanggal" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Status" Style="{StaticResource SecondaryText}"/>
                <Border x:Name="StatusBorder" Padding="10,5" CornerRadius="8" HorizontalAlignment="Left" Margin="0,5,0,0">
                    <TextBlock x:Name="TxtStatus" Text="Status" FontSize="12" FontWeight="Bold"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Daftar Item -->
        <TextBlock Text="Item Pesanan" Style="{StaticResource SecondaryText}" Margin="0,0,0,10"/>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,20">
            <ItemsControl x:Name="ItemsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="15,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Menu.Name}" 
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat='Rp {0:N0}'}" 
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Total -->
        <Grid Margin="0,0,0,20">
            <TextBlock Text="Total Pembayaran" Style="{StaticResource SecondaryText}"/>
            <TextBlock x:Name="TxtTotal" Text="Rp 0" FontSize="22" FontWeight="Bold" 
                       Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Tombol -->
        <Button Content="TUTUP" Style="{StaticResource PrimaryButton}" Width="120" 
                HorizontalAlignment="Right" Click="BtnClose_Click"/>
    </StackPanel>
</UserControl>