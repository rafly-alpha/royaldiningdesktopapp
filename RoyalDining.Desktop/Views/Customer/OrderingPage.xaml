<UserControl x:Class="RoyalDining.Desktop.Views.Customer.OrderingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <!-- Katalog -->
            <ColumnDefinition Width="1*"/>
            <!-- Keranjang -->
        </Grid.ColumnDefinitions>

        <!-- ============ KIRI: KATALOG MENU ============ -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header & Filter -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Pilih Menu" Style="{StaticResource H1}"/>
                <TextBlock Text="Silakan pilih hidangan favorit Anda" Style="{StaticResource SecondaryText}"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box dengan Placeholder Manual -->
                <Grid Grid.Column="0" Margin="0,0,15,0">
                    <TextBox Style="{StaticResource ModernTextBox}" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             VerticalContentAlignment="Center"/>

                    <!-- Placeholder Text -->
                    <TextBlock Text="Cari Menu Favorit Kalian Disini" 
                               Margin="25,0,0,0" 
                               VerticalAlignment="Center" 
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <!-- Tampilkan placeholder jika SearchText kosong -->
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Filter Kategori -->
                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" 
                          Width="220" ItemsSource="{Binding Categories}" 
                          SelectedItem="{Binding SelectedCategory}">

                    <!-- Tentukan cara menampilkan item agar muncul 'Name' bukan nama class -->
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <!-- Daftar Menu (Scrollable & Dikelompokkan) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding MenuGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,30">
                                <!-- Judul & Deskripsi Kategori -->
                                <TextBlock Text="{Binding CategoryName}" Style="{StaticResource H2}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="0,0,0,15"/>

                                <!-- Grid Menu di dalam Kategori -->
                                <ItemsControl ItemsSource="{Binding}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ModernCard}" Width="220" Margin="0,0,15,15" Padding="15">
                                                <StackPanel>
                                                    <Border Height="120" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" ClipToBounds="True" Margin="0,0,0,10">
                                                        <Grid>
                                                            <materialDesign:PackIcon Kind="Food" Width="40" Height="40" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Price, StringFormat='Rp {0:N0}'}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,5,0,10"/>

                                                    <Button Content="+ Tambah" Style="{StaticResource PrimaryButton}" Height="35" 
                                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ============ KANAN: KERANJANG ============ -->
        <Border Grid.Column="1" Style="{StaticResource ModernCard}" Background="{DynamicResource SurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Keranjang -->
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Keranjang Anda" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding ActiveOrder.Id, StringFormat='Order #{0}'}" Style="{StaticResource SecondaryText}"/>
                </StackPanel>

                <!-- Item Keranjang -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CartItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Menu.Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Subtotal, StringFormat='Rp {0:N0}'}" Foreground="{DynamicResource PrimaryBrush}" FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="−" Width="28" Height="28" 
        Background="{DynamicResource SurfaceAltBrush}" 
        Foreground="{DynamicResource TextPrimaryBrush}" 
        BorderThickness="0" FontWeight="Bold" FontSize="16"
        Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
        Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
        CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding Quantity}" Width="30" TextAlignment="Center" VerticalAlignment="Center" 
           Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold"/>
                                            <Button Content="+" Width="28" Height="28" 
        Background="{DynamicResource SurfaceAltBrush}" 
        Foreground="{DynamicResource TextPrimaryBrush}" 
        BorderThickness="0" FontWeight="Bold" FontSize="16"
        Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
        CommandParameter="{Binding Menu}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Total & Tombol -->
                <StackPanel Grid.Row="2" Margin="0,15,0,0">
                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="Total" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalPrice, StringFormat='Rp {0:N0}'}" 
                                   FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <Button Content="SUBMIT PESANAN" Style="{StaticResource PrimaryButton}" Height="45" Margin="0,0,0,10"
                            Command="{Binding SubmitOrderCommand}"/>
                    <Button Content="BATAL PESANAN" Style="{StaticResource DangerButton}" Height="45"
                            Command="{Binding CancelOrderCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>