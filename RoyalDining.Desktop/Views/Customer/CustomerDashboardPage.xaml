<UserControl x:Class="RoyalDining.Desktop.Views.Customer.CustomerDashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="35">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <materialDesign:PackIcon Kind="SilverwareForkKnife" Width="120" Height="120" 
                                     Foreground="{DynamicResource PrimaryBrush}" 
                                     HorizontalAlignment="Center"/>
            <TextBlock Text="Selamat Datang di Royal Dining" Style="{StaticResource H1}" 
                       HorizontalAlignment="Center" Margin="0,20,0,5"/>
            <TextBlock Text="Siap untuk memesan hidangan lezat hari ini?" 
                       Style="{StaticResource SecondaryText}" 
                       HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <Button Content="MULAI PESANAN BARU" Style="{StaticResource PrimaryButton}" 
                    Height="55" Width="280" FontSize="16"
                    Click="BtnStartOrder_Click"/>
        </StackPanel>
    </Grid>
</UserControl>