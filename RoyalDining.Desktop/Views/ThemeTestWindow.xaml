<Window x:Class="RoyalDining.Desktop.Views.ThemeTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theme Preview"
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="🎨 Theme Preview" Style="{StaticResource H1}"/>
                <TextBlock Text="Klik tombol di kanan untuk ganti tema live" Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/>
            </StackPanel>
            <Button x:Name="BtnToggleTheme"
                    DockPanel.Dock="Right"
                    Content="🌙 Ganti ke Dark Mode"
                    Style="{StaticResource PrimaryButton}"
                    Height="45"
                    Width="220"
                    VerticalAlignment="Top"
                    Click="BtnToggleTheme_Click"/>
        </DockPanel>

        <!-- Card Demo -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Card Component" Style="{StaticResource H2}" Margin="0,0,0,15"/>
                <TextBlock Text="Ini adalah contoh card dengan efek shadow, warna yang menyesuaikan tema, dan border radius." 
                           Style="{StaticResource BodyText}" 
                           TextWrapping="Wrap" 
                           Margin="0,0,0,15"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Primary Button" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                    <Button Content="Danger Button" Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form Demo -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}">
            <StackPanel>
                <TextBlock Text="Form Components" Style="{StaticResource H2}" Margin="0,0,0,15"/>

                <TextBlock Text="Email" Style="{StaticResource SecondaryText}" Margin="0,0,0,5"/>
                <TextBox Style="{StaticResource ModernTextBox}" 
                         Text="admin@webpro.com" 
                         Margin="0,0,0,15"/>

                <TextBlock Text="Password" Style="{StaticResource SecondaryText}" Margin="0,0,0,5"/>
                <PasswordBox Style="{StaticResource ModernPasswordBox}" 
                             Password="royal123" 
                             Margin="0,0,0,15"/>

                <TextBlock Text="Status Colors" Style="{StaticResource H3}" Margin="0,10,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Border Background="{DynamicResource SuccessBrush}" Width="80" Height="30" CornerRadius="6" Margin="0,0,10,0">
                        <TextBlock Text="Success" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="{DynamicResource DangerBrush}" Width="80" Height="30" CornerRadius="6" Margin="0,0,10,0">
                        <TextBlock Text="Danger" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="{DynamicResource WarningBrush}" Width="80" Height="30" CornerRadius="6" Margin="0,0,10,0">
                        <TextBlock Text="Warning" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="{DynamicResource InfoBrush}" Width="80" Height="30" CornerRadius="6">
                        <TextBlock Text="Info" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>