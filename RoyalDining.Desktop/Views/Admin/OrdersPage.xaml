<UserControl x:Class="RoyalDining.Desktop.Views.Admin.OrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource BackgroundBrush}">

    <materialDesign:DialogHost x:Name="DialogHostMain" Identifier="RootDialog" CloseOnClickAway="False">
        <Grid Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Kelola Pesanan" Style="{StaticResource H1}"/>
                    <TextBlock Text="Pantau dan proses pesanan customer" 
                               Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <!-- DataGrid -->
            <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="0" 
                    Background="{DynamicResource SurfaceBrush}">
                <DataGrid x:Name="OrderGrid" ItemsSource="{Binding Orders}" Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <!-- ID -->
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80" 
                                            ElementStyle="{StaticResource GridCellTextStyle}"/>

                        <!-- Customer -->
                        <DataGridTemplateColumn Header="Customer" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource PrimaryBrush}" Width="36" Height="36" 
                        CornerRadius="18" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding User.Name, Converter={StaticResource InitialsConverter}}" 
                               Foreground="White" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding User.Name}" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" FontSize="14"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Tanggal -->
                        <DataGridTextColumn Header="Tanggal" Binding="{Binding CreatedAt, StringFormat='{}{0:dd MMM yyyy, HH:mm}'}" 
                                            Width="180" ElementStyle="{StaticResource GridCellTextStyle}"/>

                        <!-- Total -->
                        <DataGridTemplateColumn Header="Total" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalPrice, StringFormat='Rp {0:N0}'}" 
                                               FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status -->
                        <DataGridTemplateColumn Header="Status" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="StatusBorder" 
                    Padding="12,6" 
                    CornerRadius="8" 
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                                        <!-- Tambahkan ini agar tidak melar -->

                                        <TextBlock x:Name="TxtStatus" Text="{Binding Status}" 
                           FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                                        <!-- Tambahkan ini -->
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Waiting Payment">
                                            <Setter TargetName="StatusBorder" Property="Background" Value="#FFF3E0"/>
                                            <Setter TargetName="TxtStatus" Property="Foreground" Value="#FF9800"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Processing">
                                            <Setter TargetName="StatusBorder" Property="Background" Value="#E3F2FD"/>
                                            <Setter TargetName="TxtStatus" Property="Foreground" Value="#2196F3"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                            <Setter TargetName="StatusBorder" Property="Background" Value="#E8F5E9"/>
                                            <Setter TargetName="TxtStatus" Property="Foreground" Value="#4CAF50"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                            <Setter TargetName="StatusBorder" Property="Background" Value="#FFEBEE"/>
                                            <Setter TargetName="TxtStatus" Property="Foreground" Value="#F44336"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Aksi -->
                        <DataGridTemplateColumn Header="Aksi" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                        <!-- Tombol Detail (Kotak Biru Muda) -->
                                        <Button Click="BtnDetail_Click" Tag="{Binding}"
                        Background="#E3F2FD" 
                        Width="38" Height="38" 
                        Padding="0" BorderThickness="0" Cursor="Hand" ToolTip="Lihat Detail"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Margin="0,0,10,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Viewbox Width="20" Height="20" Stretch="Uniform">
                                                <materialDesign:PackIcon Kind="Eye" Foreground="#2196F3"/>
                                            </Viewbox>
                                        </Button>

                                        <!-- Tombol Hapus (Kotak Merah Muda) -->
                                        <Button Click="BtnDelete_Click" Tag="{Binding}"
                        Background="#FFEBEE" 
                        Width="38" Height="38" 
                        Padding="0" BorderThickness="0" Cursor="Hand" ToolTip="Hapus"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Viewbox Width="20" Height="20" Stretch="Uniform">
                                                <materialDesign:PackIcon Kind="Delete" Foreground="#F44336"/>
                                            </Viewbox>
                                        </Button>

                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>