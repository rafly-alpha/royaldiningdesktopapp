<UserControl x:Class="RoyalDining.Desktop.Views.Admin.CategoriesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource BackgroundBrush}">
    
    <materialDesign:DialogHost x:Name="DialogHostMain" Identifier="RootDialog" CloseOnClickAway="False">
        <Grid Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- DataGrid -->
            </Grid.RowDefinitions>

            <!-- ============ HEADER ============ -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Kelola Kategori" Style="{StaticResource H1}"/>
                    <TextBlock Text="Atur klasifikasi menu makanan dan minuman" 
                               Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Click="BtnAdd_Click" Height="45" Width="180"
                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" 
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Tambah Kategori" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ============ DATA GRID ============ -->
            <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="0" 
                    Background="{DynamicResource SurfaceBrush}">
                <DataGrid x:Name="CategoryGrid"
                          ItemsSource="{Binding Categories}"
                          Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        
                        <!-- ID -->
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80" 
                                            ElementStyle="{StaticResource GridCellTextStyle}"/>

                        <!-- Nama Kategori (dengan ikon) -->
                        <DataGridTemplateColumn Header="Nama Kategori" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#FFF3E0" Width="38" Height="38" CornerRadius="10" Margin="0,0,15,0">
                                            <materialDesign:PackIcon Kind="TagMultiple" Width="20" Height="20" 
                                                                     Foreground="#FF9800" 
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Deskripsi -->
                        <DataGridTextColumn Header="Deskripsi" Binding="{Binding Description}" Width="2*"
                                            ElementStyle="{StaticResource GridCellTextStyle}"/>

                        <!-- Aksi -->
                        <DataGridTemplateColumn Header="Aksi" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Click="BtnEdit_Click" Tag="{Binding}"
                                                Background="#E3F2FD" Width="38" Height="38" 
                                                Padding="0" BorderThickness="0" Cursor="Hand" ToolTip="Edit"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                Margin="0,0,10,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Viewbox Width="20" Height="20">
                                                <materialDesign:PackIcon Kind="Pencil" Foreground="#2196F3"/>
                                            </Viewbox>
                                        </Button>
                                        <Button Click="BtnDelete_Click" Tag="{Binding}"
                                                Background="#FFEBEE" Width="38" Height="38" 
                                                Padding="0" BorderThickness="0" Cursor="Hand" ToolTip="Hapus"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Viewbox Width="20" Height="20">
                                                <materialDesign:PackIcon Kind="Delete" Foreground="#F44336"/>
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>