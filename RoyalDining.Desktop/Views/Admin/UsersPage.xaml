<UserControl x:Class="RoyalDining.Desktop.Views.Admin.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource BackgroundBrush}">

    <materialDesign:DialogHost x:Name="DialogHostMain" Identifier="RootDialog" CloseOnClickAway="False">
        <Grid Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Kelola Pengguna" Style="{StaticResource H1}"/>
                    <TextBlock Text="Atur akun admin dan customer" Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Click="BtnAdd_Click" Height="45" Width="180"
                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Tambah User" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- DataGrid -->
            <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="0" 
                    Background="{DynamicResource SurfaceBrush}">
                <DataGrid x:Name="UserGrid" ItemsSource="{Binding Users}" Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <!-- ID -->
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80" 
                                            ElementStyle="{StaticResource GridCellTextStyle}"/>

                        <!-- Nama -->
                        <DataGridTemplateColumn Header="Nama" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource PrimaryBrush}" Width="36" Height="36" 
                                                CornerRadius="18" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name, Converter={StaticResource InitialsConverter}}" 
                                                       Foreground="White" FontWeight="Bold" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" FontSize="14"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Email -->
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="250"
                                            ElementStyle="{StaticResource GridCellTextStyle}"/>

                        <!-- Role -->
                        <DataGridTemplateColumn Header="Role" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="RoleBorder" 
                    Padding="10,5" 
                    CornerRadius="12" 
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                                        <!-- TAMBAHKAN INI -->
                                        <TextBlock x:Name="TxtRole" 
                           Text="{Binding Role}" 
                           FontSize="12" 
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                                        <!-- TAMBAHKAN INI -->
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="Admin">
                                            <Setter TargetName="RoleBorder" Property="Background" Value="#FFF3E0"/>
                                            <Setter TargetName="TxtRole" Property="Foreground" Value="#FF9800"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Role}" Value="Customer">
                                            <Setter TargetName="RoleBorder" Property="Background" Value="#E3F2FD"/>
                                            <Setter TargetName="TxtRole" Property="Foreground" Value="#2196F3"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Aksi -->
                        <DataGridTemplateColumn Header="Aksi" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Click="BtnEdit_Click" Tag="{Binding}"
                                                Background="#E3F2FD" Width="38" Height="38" 
                                                Padding="0" BorderThickness="0" Cursor="Hand" ToolTip="Edit"
                                                Margin="0,0,10,0"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Viewbox Width="18" Height="18">
                                                <materialDesign:PackIcon Kind="Pencil" Foreground="#2196F3"/>
                                            </Viewbox>
                                        </Button>
                                        <Button Click="BtnDelete_Click" Tag="{Binding}"
                                                Background="#FFEBEE" Width="38" Height="38" 
                                                Padding="0" BorderThickness="0" Cursor="Hand" ToolTip="Hapus"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">  
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Viewbox Width="18" Height="18">
                                                <materialDesign:PackIcon Kind="Delete" Foreground="#F44336"/>
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>