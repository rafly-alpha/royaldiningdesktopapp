<UserControl x:Class="RoyalDining.Desktop.Views.Admin.CategoryFormDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="450"
             Background="{DynamicResource SurfaceBrush}">
    <StackPanel Margin="24">
        <!-- Judul -->
        <TextBlock x:Name="TxtTitle" Text="Tambah Kategori" 
                   Style="{StaticResource H2}" 
                   Foreground="{DynamicResource TextPrimaryBrush}" 
                   Margin="0,0,0,20"/>

        <TextBlock Text="Nama Kategori" Style="{StaticResource SecondaryText}" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtName" Style="{StaticResource ModernTextBox}" 
         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>

        <TextBlock Text="Deskripsi (Opsional)" Style="{StaticResource SecondaryText}" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtDescription" Style="{StaticResource ModernTextBox}" 
         Foreground="{DynamicResource TextPrimaryBrush}"
         Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
         Margin="0,0,0,20"/>

        <!-- Error Message -->
        <TextBlock x:Name="TxtError" Foreground="{DynamicResource DangerBrush}" 
                   FontSize="13" TextWrapping="Wrap" Margin="0,0,0,15" Visibility="Collapsed"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="BATAL" Style="{StaticResource PrimaryButton}" 
                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                    Width="100" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="SIMPAN" Style="{StaticResource PrimaryButton}" 
                    Width="100" Click="BtnSave_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>