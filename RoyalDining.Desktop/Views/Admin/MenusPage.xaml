<UserControl x:Class="RoyalDining.Desktop.Views.Admin.MenusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             Background="{DynamicResource BackgroundBrush}">

    <materialDesign:DialogHost x:Name="DialogHostMain" Identifier="RootDialog" CloseOnClickAway="False">
        <Grid Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Kelola Menu" Style="{StaticResource H1}"/>
                    <TextBlock Text="Atur daftar hidangan dan minuman restoran" Style="{StaticResource SecondaryText}" Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Click="BtnAdd_Click" Height="45" Width="180"
                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Tambah Menu" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- DataGrid -->
            <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="0" Background="{DynamicResource SurfaceBrush}">
                <DataGrid x:Name="MenuGrid" ItemsSource="{Binding Menus}" Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <!-- Gambar -->
                        <DataGridTemplateColumn Header="Gambar" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="50" Height="50" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" ClipToBounds="True" HorizontalAlignment="Center">
                                        <Grid>
                                            <materialDesign:PackIcon Kind="Image" Width="20" Height="20" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Nama & Deskripsi -->
                        <DataGridTemplateColumn Header="Nama Menu" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Kategori -->
                        <DataGridTextColumn Header="Kategori" Binding="{Binding Category.Name}" Width="150" ElementStyle="{StaticResource GridCellTextStyle}"/>

                        <!-- Harga -->
                        <DataGridTemplateColumn Header="Harga" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Price, StringFormat='Rp {0:N0}'}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Aksi -->
                        <DataGridTemplateColumn Header="Aksi" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Click="BtnEdit_Click" Tag="{Binding}"
                                                Background="#E3F2FD" Width="38" Height="38" 
                                                Padding="0" BorderThickness="0" Cursor="Hand" ToolTip="Edit"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                Margin="0,0,10,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Viewbox Width="18" Height="18">
                                                <materialDesign:PackIcon Kind="Pencil" Foreground="#2196F3"/>
                                            </Viewbox>
                                        </Button>
                                        <Button Click="BtnDelete_Click" Tag="{Binding}"
                                                Background="#FFEBEE" Width="38" Height="38" 
                                                Padding="0" BorderThickness="0" Cursor="Hand" ToolTip="Hapus"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Viewbox Width="18" Height="18">
                                                <materialDesign:PackIcon Kind="Delete" Foreground="#F44336"/>
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>