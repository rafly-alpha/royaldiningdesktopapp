<UserControl x:Class="RoyalDining.Desktop.Views.Admin.OrderDetailDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="600"
             Background="{DynamicResource SurfaceBrush}">
    <StackPanel Margin="24">
        <!-- Judul -->
        <TextBlock x:Name="TxtTitle" Text="Detail Pesanan" 
                   Style="{StaticResource H2}" 
                   Foreground="{DynamicResource TextPrimaryBrush}" 
                   Margin="0,0,0,20"/>

        <!-- Info Customer & Tanggal -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Customer" Style="{StaticResource SecondaryText}"/>
                <TextBlock x:Name="TxtCustomer" Text="Nama Customer" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Tanggal Pesanan" Style="{StaticResource SecondaryText}"/>
                <TextBlock x:Name="TxtDate" Text="Tanggal" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15"/>
            </StackPanel>
        </Grid>

        <!-- Daftar Item -->
        <TextBlock Text="Item Pesanan" Style="{StaticResource SecondaryText}" Margin="0,0,0,10"/>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,20">
            <ItemsControl x:Name="ItemsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="15,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Menu.Name}" 
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat='Rp {0:N0}'}" 
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Total & Status -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Total Harga" Style="{StaticResource SecondaryText}"/>
                <TextBlock x:Name="TxtTotal" Text="Rp 0" FontSize="22" FontWeight="Bold" 
                           Foreground="{DynamicResource PrimaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                <TextBlock Text="Status Pesanan" Style="{StaticResource SecondaryText}" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbStatus" Style="{StaticResource ModernComboBox}" Width="200">
                    <ComboBoxItem Content="Pending"/>
                    <ComboBoxItem Content="Waiting Payment"/>
                    <ComboBoxItem Content="Processing"/>
                    <ComboBoxItem Content="Completed"/>
                    <ComboBoxItem Content="Cancelled"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="TUTUP" Style="{StaticResource PrimaryButton}" 
                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                    Width="100" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="SIMPAN STATUS" Style="{StaticResource PrimaryButton}" 
                    Width="150" Click="BtnSave_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>