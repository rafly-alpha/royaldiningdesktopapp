<UserControl x:Class="RoyalDining.Desktop.Views.Admin.MenuFormDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="650"
             Background="{DynamicResource SurfaceBrush}">
    <StackPanel Margin="24">
        <!-- Judul -->
        <TextBlock x:Name="TxtTitle" Text="Tambah Menu Baru" 
                   Style="{StaticResource H2}" 
                   Foreground="{DynamicResource TextPrimaryBrush}" 
                   Margin="0,0,0,20"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Kolom Kiri: Form -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="Nama Menu" Style="{StaticResource SecondaryText}" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtName" Style="{StaticResource ModernTextBox}" 
                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>

                <TextBlock Text="Kategori" Style="{StaticResource SecondaryText}" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbCategory" Style="{StaticResource ModernComboBox}" 
                          DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,15"/>

                <TextBlock Text="Harga (Rp)" Style="{StaticResource SecondaryText}" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtPrice" Style="{StaticResource ModernTextBox}" 
                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,15"/>

                <TextBlock Text="Deskripsi (Opsional)" Style="{StaticResource SecondaryText}" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtDescription" Style="{StaticResource ModernTextBox}" 
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <!-- Kolom Kanan: Gambar -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Gambar Menu" Style="{StaticResource SecondaryText}" Margin="0,0,0,5"/>

                <Border x:Name="ImgBorder" Height="150" CornerRadius="10" 
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Margin="0,0,0,10">
                    <Grid>
                        <materialDesign:PackIcon x:Name="IconPlaceholder" Kind="Image" Width="40" Height="40" 
                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="ImgPreview" Stretch="UniformToFill" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <Button Content="Pilih Gambar" Style="{StaticResource PrimaryButton}" 
                        Height="40" Click="BtnPickImage_Click"/>
                <TextBlock x:Name="TxtImageName" Text="Belum ada gambar" 
                           Style="{StaticResource SecondaryText}" 
                           TextTrimming="CharacterEllipsis" Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Error Message -->
        <TextBlock x:Name="TxtError" Foreground="{DynamicResource DangerBrush}" 
                   FontSize="13" TextWrapping="Wrap" Margin="0,15,0,0" Visibility="Collapsed"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="BATAL" Style="{StaticResource PrimaryButton}" 
                    Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                    Width="100" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="SIMPAN" Style="{StaticResource PrimaryButton}" 
                    Width="100" Click="BtnSave_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>