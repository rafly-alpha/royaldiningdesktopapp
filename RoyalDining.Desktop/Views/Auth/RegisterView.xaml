<Window x:Class="RoyalDining.Desktop.Views.Auth.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Royal Dining — Daftar"
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" 
                  ResizeBorderThickness="6" 
                  GlassFrameThickness="0" 
                  CornerRadius="0" 
                  UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel Kiri -->
        <Border Grid.Column="0" Background="{DynamicResource PrimaryBrush}">
            <Grid>
                <Ellipse Width="500" Height="500" Fill="White" Opacity="0.05" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-150,-150,0,0"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                    <materialDesign:PackIcon Kind="AccountPlus" Width="120" Height="120" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Bergabung Bersama Kami" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,20,0,10" TextAlignment="Center"/>
                    <TextBlock Text="Daftarkan diri Anda dan nikmati kemudahan memesan hidangan mewah." FontSize="16" Foreground="White" Opacity="0.9" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Panel Kanan -->
        <Grid Grid.Column="1">
            <!-- Window Controls -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                <Button Width="45" Height="35" Background="Transparent" BorderThickness="0" Click="BtnMinimize_Click" Cursor="Hand" ToolTip="Minimize">
                    <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>
                <Button Width="45" Height="35" Background="Transparent" BorderThickness="0" Click="BtnMaximize_Click" Cursor="Hand" ToolTip="Maximize/Restore">
                    <materialDesign:PackIcon x:Name="IconMaximize" Kind="WindowMaximize" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>
                <Button Width="45" Height="35" Background="Transparent" BorderThickness="0" Click="BtnClose_Click" Cursor="Hand" ToolTip="Close">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>
            </StackPanel>

            <!-- Form Register -->
            <StackPanel VerticalAlignment="Center" Margin="80,0,80,0" Width="380" HorizontalAlignment="Center">
                <TextBlock Text="Buat Akun Baru" Style="{StaticResource H1}" Margin="0,0,0,5"/>
                <TextBlock Text="Isi data di bawah untuk mendaftar." Style="{StaticResource SecondaryText}" Margin="0,0,0,30"/>

                <Border Background="{DynamicResource DangerBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,20"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="Nama Lengkap" Style="{StaticResource SecondaryText}" Margin="0,0,0,5"/>
                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                <TextBlock Text="Alamat Email" Style="{StaticResource SecondaryText}" Margin="0,0,0,5"/>
                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                <TextBlock Text="Kata Sandi" Style="{StaticResource SecondaryText}" Margin="0,0,0,5"/>
                <PasswordBox x:Name="TxtPassword" Style="{StaticResource ModernPasswordBox}" PasswordChanged="TxtPassword_PasswordChanged" Margin="0,0,0,15"/>

                <TextBlock Text="Konfirmasi Kata Sandi" Style="{StaticResource SecondaryText}" Margin="0,0,0,5"/>
                <PasswordBox x:Name="TxtConfirmPassword" Style="{StaticResource ModernPasswordBox}" PasswordChanged="TxtConfirmPassword_PasswordChanged" Margin="0,0,0,30"/>

                <Button Content="DAFTAR SEKARANG" Style="{StaticResource PrimaryButton}" Height="50" FontSize="16"
                        Command="{Binding RegisterCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>

                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                    <TextBlock Text="Sudah punya akun? " Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                    <Button Content="Masuk di sini" 
                            Background="Transparent" BorderThickness="0" 
                            Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" Cursor="Hand" Padding="5,0"
                            Click="GoToLogin_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}" Padding="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>