<Window x:Class="RoyalDining.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Royal Dining"
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" 
                      ResizeBorderThickness="6" 
                      GlassFrameThickness="0" 
                      CornerRadius="0" 
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar Lebih Lebar -->
            <ColumnDefinition Width="280"/>
            <!-- Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ SIDEBAR ============ -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo Header Sidebar -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="25,30,25,30" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="Crown" Width="38" Height="38" 
                                             Foreground="{DynamicResource PrimaryBrush}" 
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Royal Dining" FontSize="24" FontWeight="Bold" 
                               Foreground="{DynamicResource PrimaryBrush}" 
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <!-- Menu Items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MenuStackPanel" Margin="12,0">
                        <!-- Populated from Code-Behind -->
                    </StackPanel>
                </ScrollViewer>

                <!-- User Info & Logout -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <!-- Avatar -->
                            <Border Width="48" Height="48" CornerRadius="24" 
                                    Background="{DynamicResource PrimaryBrush}">
                                <TextBlock x:Name="TxtInitials" Text="?" Foreground="White" FontWeight="Bold" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Nama & Role -->
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtUserName" Text="Nama User" FontWeight="Bold" 
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15"/>
                                <TextBlock x:Name="TxtUserRole" Text="Role" FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Tombol Logout -->
                        <Button Content="LOGOUT" Height="42" Margin="0,20,0,0" FontSize="14" FontWeight="SemiBold"
                                Style="{StaticResource DangerButton}" Click="BtnLogout_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ CONTENT AREA ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Top Bar Lebih Tinggi -->
                <RowDefinition Height="75"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Judul Halaman -->
                    <TextBlock Grid.Column="0" x:Name="TxtPageTitle" Text="Dashboard" 
                               FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="35,0,0,0"/>

                    <!-- Kontrol Kanan -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <!-- Theme Toggle -->
                        <Button x:Name="BtnTheme" Width="55" Background="Transparent" BorderThickness="0"
                                Click="BtnTheme_Click" Cursor="Hand" ToolTip="Ganti Tema"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <materialDesign:PackIcon x:Name="IconTheme" Kind="WeatherNight" Width="22" Height="22" 
                                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>

                        <!-- Window Controls -->
                        <Button Width="50" Background="Transparent" BorderThickness="0" Click="BtnMinimize_Click" 
                                Cursor="Hand" ToolTip="Minimize" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18" 
                                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                        <Button Width="50" Background="Transparent" BorderThickness="0" Click="BtnMaximize_Click" 
                                Cursor="Hand" ToolTip="Maximize/Restore" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <materialDesign:PackIcon x:Name="IconMaximize" Kind="WindowMaximize" Width="18" Height="18" 
                                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                        <Button Width="50" Background="Transparent" BorderThickness="0" Click="BtnClose_Click" 
                                Cursor="Hand" ToolTip="Close" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" 
                                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Frame -->
            <ContentControl x:Name="MainContent" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>