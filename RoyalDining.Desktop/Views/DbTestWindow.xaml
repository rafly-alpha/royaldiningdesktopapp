<Window x:Class="RoyalDining.Desktop.Views.DbTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DB Test"
        Height="400" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button x:Name="BtnTest"
                Grid.Row="0"
                Content="🔗 TEST KONEKSI DATABASE"
                Height="50"
                FontSize="16"
                FontWeight="Bold"
                Click="BtnTest_Click"/>

        <Border Grid.Row="1" 
                Margin="0,20,0,0"
                BorderBrush="Gray" 
                BorderThickness="1" 
                Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtResult"
                           FontFamily="Consolas"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Text="Klik tombol di atas untuk test..."/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>